{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Write",
      "Edit",
      "WebSearch",
      "WebFetch",
      "Command",
      "Skill",
      "mcp__ide__getDiagnostics",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__MiniMax__web_search",
      "mcp__MiniMax__understand_image",
      "Bash(head:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(dir:*)",
      "Bash(head:*)",
      "Bash(less:*)",
      "Bash(cat:*)",
      "Bash(findstr:*)",
      "Bash(sed:*)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(wc:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git mv:*)",
      "Bash(bun .claude/scripts/*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(chmod:777)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Read(./**/.env*)",
      "Read(./**/*.local.json)",
      "Read(./**/secrets/**)",
      "Read(./**/config/*.key)",
      "Read(./**/credentials/**)",
      "Read(./**/*security/**)"
    ],
    "ask": [],
    "disableBypassPermissionsMode": "disable"
  },
  "statusLine": {
    "type": "command",
    "command": "powershell -File \".claude/statusline.ps1\""
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@superpowers-marketplace": true
  },
  "language": "concise english"
}
